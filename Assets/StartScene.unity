--- !u!114 &887911145
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 887911141}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 755307d5a06e35942a6acb2f73ec8071, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 823657468}
  nameText: {fileID: 769073623}
  dialogueText: {fileID: 433447836}
  Felyne: {fileID: 729648616}
  Spirit: {fileID: 1488329432}
  typeSpeed: 0.04
  audioSource: {fileID: 887911146}
  typeSound: {fileID: 8300000, guid: 630a2da998da712419bbc718237dc8a1, type: 3}
  charsPerSound: 3
  lines:
  - speakerName: Felyne
    portrait: {fileID: 21300000, guid: ffed1be638f55574d93de7f7441684b0, type: 3}
    text: wait..wasn't I just asleep?
  - speakerName: Spirit
    portrait: {fileID: 21300000, guid: 5003da403571946f4897c4a28a5cf323, type: 3}
    text: Felyne..Welcome.
  - speakerName: Felyne
    portrait: {fileID: 21300000, guid: ffed1be638f55574d93de7f7441684b0, type: 3}
    text: Ah, wh..who are you?
  - speakerName: Spirit
    portrait: {fileID: 21300000, guid: 5003da403571946f4897c4a28a5cf323, type: 3}
    text: You don't have to know who I am.. But I know you are struggling with making
      cakes.. And I can help you.
  - speakerName: Felyne
    portrait: {fileID: 21300000, guid: ffed1be638f55574d93de7f7441684b0, type: 3}
    text: How can you help me, I've tried thousands of times, and couldn't make it.
  - speakerName: Spirit
    portrait: {fileID: 21300000, guid: 5003da403571946f4897c4a28a5cf323, type: 3}
    text: Don't worry.. Why don't you just become an ingredient and possibly you'll
      get some idea.. (whisper)
  - speakerName: Felyne
    portrait: {fileID: 21300000, guid: ffed1be638f55574d93de7f7441684b0, type: 3}
    text: 'A WHAT!!? INGREDIENTS? NOOO, I just want make good cake! '
  - speakerName: Spirit
    portrait: {fileID: 21300000, guid: 5003da403571946f4897c4a28a5cf323, type: 3}
    text: (chuckle) Then... Here's your chance Felyne, ready to make a cake? Success...
      Or become MY ingredient.. GOOD LUCK..
