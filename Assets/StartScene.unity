--- !u!114 &846931090
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 846931088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8da4029580840de4a9410e5b00bb4dda, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  startGroup: {fileID: 1941752298}
  cgGroup: {fileID: 1212820268}
  startButton: {fileID: 1291130148}
  skipButton: {fileID: 55873916}
  cgText: {fileID: 1969400522}
  cgLines:
  - ' In a cozy kitchen filled with the scent of sugar and fresh strawberries'
  - a cat named Felyne stood on his stool
  - his fur was dusted with flour, whisk in paw and hope in heart
  - For as long as he could remember
  - Felyne had been dreaming of baking a perfect cake
  - but every try turned into a disaster
  - Tonight, unfortunately, as usual, things didn't go as planned
  - As the smoke from the last sponge curled from the oven
  - Felyne's whiskers drooped, a long and tired sigh escaped him
  - ' "Perhaps I just couldn''t..." he murmured'
  - Slowly, Felyne curled up beside the oven, his eyes grew heavy
  - As he drifted into sleep, the air around him seemed to shimmer faintly
  - 'the scent of strawberries grew, sweet and soft '
  - "as though the dream he'd longed for was finally beginning to rise... \r\n"
  fadeDuration: 1
  textDisplayTime: 1.5
  mainSceneName: MainScene
  uiAudioSource: {fileID: 221251179}
  hoverClip: {fileID: 8300000, guid: 092c2ab0acd7b6c48991a70faed9f9f9, type: 3}
  clickClip: {fileID: 8300000, guid: 4de9160341b8376419f965a437138e22, type: 3}
